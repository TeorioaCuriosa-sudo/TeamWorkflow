# Copia este ficheiro para .env e ajusta. Nunca envies o .env para o GitHub.

# ---------- Endereço público ----------
# O endereço pelo qual a equipa abre a plataforma (sem barra no fim).
# É usado nas ligações dos emails ("Abrir na plataforma") e para marcar o cookie de sessão como seguro.
APP_URL=https://workflow.teudominio.pt

# 1 se estiveres atrás de um proxy inverso ou túnel (Cloudflare Tunnel, Caddy, nginx…):
# assim o limite de tentativas de login usa o IP real de cada pessoa.
TRUST_PROXY=1

# ---------- Primeiro administrador ----------
# Só é usado quando ainda não existe nenhum administrador (primeiro arranque).
# Se deixares a palavra-passe vazia, é gerada uma temporária e escrita nos registos do servidor
# (docker compose logs teoria-workflow). Em qualquer dos casos, é pedido que a mudes no primeiro acesso.
ADMIN_EMAIL=tu@teudominio.pt
ADMIN_NAME=O Teu Nome
# ADMIN_PASSWORD=

# ---------- Emails (opcional) ----------
# Sem SMTP_HOST a plataforma funciona na mesma; os avisos ficam só no sino do cabeçalho.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# Porta 465 usa TLS direto: define SMTP_SECURE=1. Na 587 a ligação passa a TLS automaticamente.
# SMTP_SECURE=0
# SMTP_USER=utilizador
# SMTP_PASS=palavra-passe-ou-chave-de-aplicacao
# Remetente que aparece nos emails:
# MAIL_FROM=Teoria Workflow <workflow@teudominio.pt>

# ---------- Outros ----------
# Fuso horário que decide quando começa um novo mês.
APP_TZ=Europe/Lisbon

# Feriados locais (municipal, por exemplo), separados por vírgulas: 2026-06-24,2027-06-24
EXTRA_HOLIDAYS=

# Quantas cópias diárias da base de dados guardar.
BACKUP_KEEP=30

# Tamanho máximo de cada ficheiro anexado (projetos, tópicos, tarefas e modelos), em MB.
# Se usas um túnel ou proxy que limita o tamanho dos pedidos (o Cloudflare gratuito aceita 100 MB), mantém este valor abaixo.
# Os ficheiros ficam em data/uploads (no Docker, no mesmo volume da base de dados): inclui-os nas tuas cópias.
MAX_UPLOAD_MB=50
